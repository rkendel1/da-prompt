# Providers — set any you have; local servers are found automatically when running.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
# Local servers (defaults shown)
# OLLAMA_HOST=http://127.0.0.1:11434
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Optional: force defaults (otherwise: last used, else first ready provider)
# FACTORY_PROVIDER=ollama
# FACTORY_MODEL=qwen2.5-coder:14b
# FACTORY_PLANNER_MODEL=
# FACTORY_MAX_OUTPUT_TOKENS=8192

# Server
PORT=3000
HOST=0.0.0.0
FACTORY_DATA_DIR=./data
# Strongly recommended whenever the server is reachable by anyone else: agents run shell commands.
FACTORY_PASSWORD=

# Factory defaults (each run can override in the UI)
FACTORY_MAX_PARALLEL=3
FACTORY_MAX_ATTEMPTS=3
FACTORY_MAX_AGENT_TURNS=40
FACTORY_TOKEN_BUDGET=2000000
FACTORY_COMMAND_TIMEOUT_MS=180000
FACTORY_MAX_PREVIEWS=5

# Optional: push each finished project to the repo URL given on the run
GITHUB_TOKEN=

# Offline provider: inject one realistic fault so the feedback loop is exercised (on|off)
FACTORY_OFFLINE_FAULTS=on   # on | persistent (demo escalation) | off
FACTORY_OFFLINE_DELAY_MS=350
