# Claude provider (omit to use the offline demo agents)
ANTHROPIC_API_KEY=
FACTORY_MODEL=claude-sonnet-5-5
FACTORY_PLANNER_MODEL=claude-opus-5-5

# Server
PORT=3000
HOST=0.0.0.0
FACTORY_DATA_DIR=./data
# Strongly recommended whenever the server is reachable by anyone else: agents run shell commands.
FACTORY_PASSWORD=

# Factory defaults (each run can override in the UI)
FACTORY_MAX_PARALLEL=3
FACTORY_MAX_ATTEMPTS=3
FACTORY_MAX_AGENT_TURNS=40
FACTORY_TOKEN_BUDGET=2000000
FACTORY_COMMAND_TIMEOUT_MS=180000
FACTORY_MAX_PREVIEWS=5

# Optional: push each finished project to the repo URL given on the run
GITHUB_TOKEN=

# Offline provider: inject one realistic fault so the feedback loop is exercised (on|off)
FACTORY_OFFLINE_FAULTS=on   # on | persistent (demo escalation) | off
FACTORY_OFFLINE_DELAY_MS=350
