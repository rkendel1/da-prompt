# Providers — set any you have; local servers are found automatically when running.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
# Local servers (defaults shown)
# OLLAMA_HOST=http://127.0.0.1:11434
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Check what a configuration resolves to without calling any model:  da-prompt diagnostics   (see README "Local tuning")
# Optional: force defaults (otherwise: the provider/model the last run used, else the first ready provider).
# Hosted example (no local model needed); Ollama stays selectable per run with --provider ollama:
# FACTORY_PROVIDER=openai
# FACTORY_MODEL=
# FACTORY_PROVIDER=ollama
# FACTORY_MODEL=qwen2.5-coder:14b
# Plan with a different provider than the one that executes, e.g. frontier planner + local agents:
# FACTORY_PLANNER_PROVIDER=anthropic
# FACTORY_PLANNER_MODEL=
# Who runs each task: builtin (default; every provider; waits up to 30 min per model request) or fx (experimental; npm run
# engine:install -- fx; OpenAI-compatible endpoints only; ~120 s limit for the first response, no num_ctx/timeout/retry settings).
# Prefer builtin for slow local models. Each run can override it.
# FACTORY_AGENT_ENGINE=builtin
# Output-token limit per model response; honoured by both engines.
# FACTORY_MAX_OUTPUT_TOKENS=8192

# Server
PORT=4747
HOST=0.0.0.0
FACTORY_DATA_DIR=./data
# Where runs may deliver finished projects. Set it to confine them (relative names resolve inside it);
# leave unset to allow any new/empty folder.
# FACTORY_OUTPUT_ROOT=~/Projects
# Strongly recommended whenever the server is reachable by anyone else: agents run shell commands.
FACTORY_PASSWORD=

# Factory defaults (each run can override in the UI)
# Existing projects: install dependencies in the run's isolated workspace before the baseline (runs the project's install scripts)
# FACTORY_ALLOW_INSTALL=1
FACTORY_MAX_PARALLEL=3
FACTORY_MAX_ATTEMPTS=3
FACTORY_MAX_AGENT_TURNS=40
FACTORY_TOKEN_BUDGET=2000000
FACTORY_COMMAND_TIMEOUT_MS=180000
FACTORY_MAX_PREVIEWS=5

# Optional: push each finished project to the repo URL given on the run
GITHUB_TOKEN=

# Offline provider: inject one realistic fault so the feedback loop is exercised (on|off)
FACTORY_OFFLINE_FAULTS=on   # on | persistent (demo escalation) | off
FACTORY_OFFLINE_DELAY_MS=350

# Existing projects: directories the factory may use as local projects (path-delimiter separated).
# Read-only roots can be inspected and used as a source but results are never applied back.
FACTORY_PROJECT_ROOTS=
FACTORY_PROJECT_ROOTS_READONLY=
# Git hosts GitHub-backed runs may clone from (add a GitHub Enterprise host); FACTORY_GITHUB_API_URL overrides the REST base.
FACTORY_GIT_HOSTS=github.com

# PAX (project observation): empty = look for `pax` on the server's PATH
# FACTORY_PAX_PATH=
# FACTORY_PAX_TIMEOUT_MS=120000
