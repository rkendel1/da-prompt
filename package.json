{
  "name": "da-prompt",
  "version": "1.0.0",
  "description": "A software factory: turns an idea into a working, verified, deployed application using a graph of specialized AI agents.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "da-prompt": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cli": "node src/cli.js",
    "factory": "node src/cli.js",
    "check": "node scripts/check.mjs",
    "lint": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "validate": "node scripts/check.mjs && node scripts/build.mjs && node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "src",
    "public",
    "templates",
    "scripts",
    "README.md",
    "LICENSE"
  ]
}
